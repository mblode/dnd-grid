{
  "name": "@dnd-grid/core",
  "version": "1.3.1",
  "description": "Headless layout engine for dnd-grid",
  "keywords": [
    "dnd",
    "drag",
    "grid",
    "layout",
    "resize"
  ],
  "homepage": "https://github.com/mblode/dnd-grid",
  "bugs": {
    "url": "https://github.com/mblode/dnd-grid/issues"
  },
  "license": "MIT",
  "author": "Matthew Blode <mblode@users.noreply.github.com> (https://github.com/mblode)",
  "repository": {
    "type": "git",
    "url": "git@github.com:mblode/dnd-grid.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layout-engine": {
      "types": "./dist/layout-engine.d.ts",
      "import": "./dist/layout-engine.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc --p ./tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "ultracite check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "ultracite": "7.9.3",
    "vitest": "^4.1.10"
  }
}
