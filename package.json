{
  "name": "dnd-grid",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "changeset publish",
    "release:publish": "turbo run build --filter=@dnd-grid/core --filter=@dnd-grid/react && changeset publish",
    "dev": "turbo run dev",
    "prepare": "lefthook install || true",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "check-types": "turbo run check-types",
    "examples:sync": "npm run examples:sync-docs && npm run examples:build-registry && ultracite fix apps/docs/examples apps/web/examples apps/web/public/r apps/web/public/registry.json",
    "examples:sync-docs": "node scripts/sync-docs-examples.mjs",
    "examples:build-registry": "node scripts/generate-registry.mjs",
    "workers:dev": "npm run dev --workspace=docs-worker",
    "workers:deploy": "npm run deploy --workspace=docs-worker",
    "test": "turbo run test",
    "knip": "knip",
    "check": "npm run lint && npm run check-types",
    "verify": "npm run check && npm run test && npm run knip",
    "check-package-types": "npm run build && node scripts/check-package-types.mjs",
    "verify:full": "npm run verify && npm run check-package-types"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^26.1.1",
    "@typescript/typescript6": "^6.0.2",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "turbo": "^2.10.4",
    "typescript": "7.0.2",
    "ultracite": "7.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@10.9.3"
}
